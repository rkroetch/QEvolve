{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run QEvolve",
            "type": "process",
            "command": "${command:cmake.launchTargetPath}",
            "options": {
                "cwd": "${command:cmake.launchTargetDirectory}",
                "env": {
                    "PATH": "C:\\Qt\\6.11.2\\msvc2022_64\\bin;${env:PATH}",
                    "QT_PLUGIN_PATH": "C:\\Qt\\6.11.2\\msvc2022_64\\plugins"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "showReuseMessage": false
            }
        },
        {
            "label": "Build Tests",
            "type": "cmake",
            "command": "build",
            "targets": ["QEvolveTests"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build Benchmarks",
            "type": "cmake",
            "command": "build",
            "targets": ["QEvolveBenchmarks"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Run Tests",
            "type": "process",
            "command": "${command:cmake.buildDirectory}/${command:cmake.buildType}/QEvolveTests.exe",
            "options": {
                "cwd": "${command:cmake.buildDirectory}/${command:cmake.buildType}",
                "env": {
                    "PATH": "C:\\Qt\\6.11.2\\msvc2022_64\\bin;${env:PATH}",
                    "QT_PLUGIN_PATH": "C:\\Qt\\6.11.2\\msvc2022_64\\plugins"
                }
            },
            "dependsOn": "Build Tests",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "Run Benchmarks",
            "type": "process",
            "command": "${command:cmake.buildDirectory}/${command:cmake.buildType}/QEvolveBenchmarks.exe",
            "options": {
                "cwd": "${command:cmake.buildDirectory}/${command:cmake.buildType}",
                "env": {
                    "PATH": "C:\\Qt\\6.11.2\\msvc2022_64\\bin;${env:PATH}",
                    "QT_PLUGIN_PATH": "C:\\Qt\\6.11.2\\msvc2022_64\\plugins"
                }
            },
            "dependsOn": "Build Benchmarks",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        }
    ]
}
